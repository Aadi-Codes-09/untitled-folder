# MediKiosk Backend Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=MediKiosk
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
POSTGRES_USER=medikiosk
POSTGRES_PASSWORD=medikiosk_dev
POSTGRES_DB=medikiosk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ABDM / ABHA Integration
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_CALLBACK_URL=http://localhost:8000/api/v1/auth/abdm/callback

# AI / LLM (OpenAI)
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# OCR
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=eng+hin

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=/tmp/medikiosk_uploads

# FHIR
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# Logging
LOG_LEVEL=INFO